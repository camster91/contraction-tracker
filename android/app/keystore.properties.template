# Olive — Release Keystore Properties
# DO NOT COMMIT THIS FILE. Add android/app/keystore.properties to .gitignore.
#
# Generate the keystore with:
#   keytool -genkey -v \
#     -keystore android/app/olive-upload.keystore \
#     -alias olive \
#     -keyalg RSA -keysize 2048 -validity 25000
#
# Then fill in this file. cd android && ./gradlew bundleRelease will
# pick these up via the build.gradle signingConfigs block.

KEYSTORE_PATH=../app/olive-upload.keystore
KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD_HERE
KEY_ALIAS=olive
KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE
